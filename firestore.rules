rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /survey_sessions/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
                      'session_id', 'result_type', 'answers', 'answers_list',
                      'source', 'submitted_at_client', 'submitted_at', 'created_at', 'updated_at'
                    ])
                    && request.resource.data.session_id is string
                    && request.resource.data.result_type is string
                    && request.resource.data.answers_list is list
                    && request.resource.data.answers_list.size() == 12
                    && request.resource.data.source == 'quiz';
      allow update, delete: if false;
    }
  }
}

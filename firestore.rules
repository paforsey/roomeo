rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /survey_sessions/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
                      'session_id', 'result_type', 'answers', 'answers_list',
                      'source', 'submitted_at_client', 'submitted_at', 'created_at', 'updated_at'
                    ])
                    && request.resource.data.session_id is string
                    && request.resource.data.result_type is string
                    && request.resource.data.answers_list is list
                    && request.resource.data.answers_list.size() == 12
                    && request.resource.data.source == 'quiz';
      allow update, delete: if false;
    }

    match /profile_sessions/{profileId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
                      'session_id', 'result_type', 'name', 'email',
                      'logistics', 'habits', 'trust', 'source',
                      'submitted_at_client', 'submitted_at', 'created_at', 'updated_at'
                    ])
                    && request.resource.data.session_id is string
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.logistics is map
                    && request.resource.data.habits is map
                    && request.resource.data.trust is map
                    && request.resource.data.source == 'profile';
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['uid', 'email', 'created_at', 'updated_at'])
                    && request.resource.data.uid == userId
                    && request.resource.data.email is string;
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.uid == userId;
      allow delete: if false;
    }
  }
}

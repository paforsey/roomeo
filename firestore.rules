rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }
    function isSuperAdmin() {
      return isStaff()
             && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'admin';
    }

    match /survey_sessions/{sessionId} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasAll([
                      'session_id', 'result_type', 'answers', 'answers_list',
                      'source', 'submitted_at_client', 'submitted_at', 'created_at', 'updated_at'
                    ])
                    && request.resource.data.session_id is string
                    && request.resource.data.result_type is string
                    && request.resource.data.answers_list is list
                    && request.resource.data.answers_list.size() == 12
                    && request.resource.data.source == 'quiz';
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /profile_sessions/{profileId} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasAll([
                      'session_id', 'result_type', 'name', 'email',
                      'logistics', 'habits', 'trust', 'source',
                      'submitted_at_client', 'submitted_at', 'created_at', 'updated_at'
                    ])
                    && request.resource.data.session_id is string
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.logistics is map
                    && request.resource.data.habits is map
                    && request.resource.data.trust is map
                    && request.resource.data.source == 'profile';
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isStaff() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['uid', 'email', 'created_at', 'updated_at'])
                    && request.resource.data.uid == userId
                    && request.resource.data.email is string;
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.uid == userId;
      allow delete: if isSuperAdmin();
    }

    match /admin_users/{staffUid} {
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == staffUid);
      allow create, update, delete: if isSuperAdmin();
    }

    match /user_profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
                            && request.resource.data.uid == userId;
      allow delete: if false;
    }

    /* Minimal username -> email lookup so the admin login form can accept a
       username instead of only an email (Firebase Auth sign-in always needs an
       actual email). Deliberately holds nothing but the email — no name, no
       role, no other admin_users fields — since this has to be publicly
       readable to resolve a username *before* anyone is signed in. */
    match /username_lookup/{username} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
